{
  "format": "paillasse-composant",
  "version": 1,
  "id": "moteur_cc_exemple",
  "nom": "Moteur CC (modèle par équations)",
  "description": "Moteur à courant continu décrit par ses équations : bobinage R, L et force contre-électromotrice K·ω",
  "categorie": "Actionneurs",
  "repere": "M",
  "sources": [ "Valeurs d'exemple d'un petit moteur 3 V : R = 3 Ω, L = 2 mH, K = 0,01 V·s/rad, J = 1e-6 kg·m²" ],
  "broches": [
    { "nom": "plus", "libelle": "+", "cote": "gauche" },
    { "nom": "moins", "libelle": "−", "cote": "gauche" }
  ],
  "noeuds": ["m"],
  "entrees": [ { "nom": "charge", "libelle": "Couple de charge", "unite": "N·m", "defaut": 0 } ],
  "sorties": [ { "nom": "vitesse", "libelle": "Vitesse", "unite": "tr/min" } ],
  "parametres": [
    { "nom": "r_bob", "libelle": "Résistance", "unite": "Ω", "defaut": 3, "min": 0.01 },
    { "nom": "l_bob", "libelle": "Inductance", "unite": "H", "defaut": 0.002, "min": 1e-6 },
    { "nom": "k", "libelle": "Constante K", "unite": "V·s/rad", "defaut": 0.01, "min": 1e-5 },
    { "nom": "j", "libelle": "Inertie", "unite": "kg·m²", "defaut": 1e-6, "min": 1e-9 },
    { "nom": "f", "libelle": "Frottement visqueux", "unite": "N·m·s", "defaut": 1e-6, "min": 0 }
  ],
  "equations": [
    "couple = k * i_bobinage - f * w - charge",
    "w = integ(couple / j)",
    "vitesse = w * 30 / pi"
  ],
  "elements": [
    { "type": "L", "nom": "bobinage", "entre": ["plus", "m"], "valeur": "l_bob", "r": "r_bob" },
    { "type": "V", "nom": "fcem", "entre": ["m", "moins"], "valeur": "k * w", "r": 0.001 }
  ],
  "affichage": ["vitesse"]
}
